# qarau-fetch configuration, loaded by systemd (EnvironmentFile=).
# Plain KEY=VALUE lines; no shell expansion. Restart after editing:
#   sudo systemctl restart qarau-fetch

QARAU_API_HOST=localhost
QARAU_API_PORT=7991

# Absolute path to yt-dlp: the service does not see your login PATH
QARAU_TOOL=/usr/local/bin/yt-dlp

# Optional JS runtime for yt-dlp, e.g. deno
#QARAU_JS_RUNTIME_NAME=deno
#QARAU_JS_RUNTIME_PATH=/usr/local/bin/deno

#QARAU_LOG_LEVEL=INFO
#QARAU_SENTRY_DSN=

# mTLS material defaults to /etc/qarau-fetch/certs/{ca.crt,fetch.crt,fetch.key}
#QARAU_MTLS_CA_CERT=
#QARAU_MTLS_CERT=
#QARAU_MTLS_KEY=
